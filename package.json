{
  "name": "agentloom",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "织序 AgentLoom — 可验证的多 Agent 团队编排与调度平台",
  "scripts": {
    "dev": "concurrently -n api,web -c cyan,magenta \"pnpm dev:api\" \"pnpm dev:web\"",
    "dev:api": "tsx watch src/server/index.ts",
    "dev:web": "vite",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "start": "tsx src/server/index.ts",
    "reset": "tsx src/server/reset.ts",
    "seed": "tsx src/server/reset.ts"
  },
  "dependencies": {
    "@fastify/multipart": "^9.2.1",
    "@fastify/static": "^8.2.0",
    "@remixicon/react": "^4.9.0",
    "@tailwindcss/postcss": "^4.3.4",
    "@xyflow/react": "^12.8.4",
    "fastify": "^5.5.0",
    "lucide-react": "^0.542.0",
    "react": "^19.1.1",
    "react-aria-components": "^1.22.1",
    "react-dom": "^19.1.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.8.2",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.4",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.1",
    "concurrently": "^9.2.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^7.1.3"
  }
}
